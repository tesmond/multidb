{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "multidb",
  "version": "0.3.0",
  "identifier": "dev.multidb.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "multidb",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#121217"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.png",
      "../build/appicon.ico",
      "../build/appicon.icns"
    ]
  }
}
