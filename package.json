{
  "name": "multidb",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run frontend:build && cd desktop && cargo run",
    "build": "npm run frontend:build && cd desktop && cargo build --release",
    "postbuild": "node -e \"if(process.platform==='darwin'){require('child_process').execSync('sh build/darwin/bundle.sh',{stdio:'inherit'})}\"",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:check": "npm --prefix frontend run check",
    "rust:check": "cd desktop && cargo check"
  }
}
